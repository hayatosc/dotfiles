#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${WSL_DISTRO_NAME:-}" || -n "${WSL_INTEROP:-}" ]] || grep -qi microsoft /proc/version 2>/dev/null; then
  if [[ $# -eq 0 ]]; then
    echo "Usage: $(basename "$0") <url-or-path>" >&2
    exit 1
  fi

  target="$1"

  if [[ "$target" == file://* ]]; then
    local_path="${target#file://}"
    local_path="${local_path#localhost}"
    if [[ -e "$local_path" ]] && command -v wslpath >/dev/null 2>&1; then
      target="$(wslpath -w "$local_path")"
    fi
  elif [[ -e "$target" ]] && command -v wslpath >/dev/null 2>&1; then
    target="$(wslpath -w "$target")"
  fi

  rundll32=""
  if command -v rundll32.exe >/dev/null 2>&1; then
    rundll32="$(command -v rundll32.exe)"
  elif command -v wslpath >/dev/null 2>&1 && command -v cmd.exe >/dev/null 2>&1; then
    sys_root="$(cmd.exe /c "echo %SystemRoot%" 2>/dev/null | tr -d '\r')"
    if [[ -n "$sys_root" ]]; then
      candidate="$(wslpath -u "$sys_root")/System32/rundll32.exe"
      [[ -x "$candidate" ]] && rundll32="$candidate"
    fi
  elif [[ -x /mnt/c/Windows/System32/rundll32.exe ]]; then
    rundll32="/mnt/c/Windows/System32/rundll32.exe"
  fi

  if [[ -n "$rundll32" ]]; then
    exec "$rundll32" url.dll,FileProtocolHandler "$target"
  fi
fi

if [[ -x /usr/bin/xdg-open ]]; then
  exec /usr/bin/xdg-open "$@"
elif command -v open >/dev/null 2>&1; then
  exec open "$@"
fi

echo "xdg-open: no browser launcher found" >&2
exit 1
