{{- $localData := joinPath .chezmoi.sourceDir ".chezmoidata" "opencode.local.toml" -}}
{{- $apiKey := "YOUR_API_KEY" -}}
{{- if stat $localData -}}
{{-   $data := include $localData | fromToml -}}
{{-   if hasKey $data "opencode" -}}
{{-     $apiKey = index $data "opencode" "api_key" | default "YOUR_API_KEY" -}}
{{-   end -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    }
  ],
  "providers": {
    "bailian-token-plan-personal": {
      "name": "QwenCloud",
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1",
        "apiKey": {{ $apiKey | toJson }}
      },
      "models": {
        "qwen3.8-max-preview": {
          "name": "Qwen3.8 Max Preview",
          "limit": {
            "context": 983616,
            "output": 131072
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 99072
            },
            "temperature": 0.6,
            "reasoning": true
          }
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus",
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus",
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.6-flash": {
          "name": "Qwen3.6 Flash",
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        }
      }
    }
  }
}
