{{- $localData := joinPath .chezmoi.sourceDir ".chezmoidata" "opencode.local.toml" -}}
{{- $apiKey := "YOUR_API_KEY" -}}
{{- if stat $localData -}}
{{-   $data := include $localData | fromToml -}}
{{-   if hasKey $data "opencode" -}}
{{-     $apiKey = index $data "opencode" "api_key" | default "YOUR_API_KEY" -}}
{{-   end -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-queue"
  ],
  "provider": {
    "bailian-token-plan-personal": {
      "npm": "@ai-sdk/anthropic",
      "name": "QwenCloud",
      "options": {
        "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1",
        "apiKey": {{ $apiKey | toJson }}
      },
      "models": {
        "qwen3.8-max-preview": {
          "name": "Qwen3.8 Max Preview",
          "contextWindow": 983616,
          "maxOutputTokens": 131072,
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 99072
            },
            "temperature": 0.6,
            "reasoning": true
          }
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.7-plus": {
