{{- $liveConfig := joinPath .chezmoi.homeDir ".codex" "config.toml" -}}
{{- $localData := joinPath .chezmoi.sourceDir ".chezmoidata" "codex.local.toml" -}}
{{- $current := dict -}}
{{- if stat $liveConfig -}}
{{-   $current = include $liveConfig | fromToml -}}
{{- else if stat $localData -}}
{{-   $current = include $localData | fromToml -}}
{{- end -}}
{{- $_ := unset $current "agents" -}}
{{- $shared := dict
      "model" "gpt-5.6-sol"
      "model_reasoning_effort" "medium"
      "plan_mode_reasoning_effort" "high"
      "approvals_reviewer" "auto_review"
      "approval_policy" "on-request"
      "features" (dict
        "guardian_approval" true
        "multi_agent_v2" (dict
          "enabled" true
          "min_wait_timeout_ms" 300000
          "default_wait_timeout_ms" 300000
          "max_wait_timeout_ms" 3600000
        )
      )
      "plugins" (dict
        "gmail@openai-curated" (dict "enabled" true)
        "github@openai-curated" (dict "enabled" true)
      )
      "notice" (dict
        "hide_rate_limit_model_nudge" true
      )
      "apps" (dict
        "connector_76869538009648d5b282a4bb21c3d157" (dict
          "tools" (dict
            "github_create_pull_request" (dict "approval_mode" "approve")
          )
        )
      )
      "tui" (dict
        "status_line" (list "model-with-reasoning" "current-dir" "context-used" "five-hour-limit" "weekly-limit")
        "status_line_use_colors" true
        "model_availability_nux" (dict "gpt-5.5" 4)
      )
-}}
{{ mergeOverwrite $current $shared | toToml }}
