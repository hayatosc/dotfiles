# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Load sheldon plugins (including zsh-autocomplete) before mise/compdef callers
# so zsh-autocomplete can intercept compdef and run compinit with its Completions dir.
if (( $+commands[sheldon] )); then
  eval "$(sheldon source)"
fi

if [ -f "$HOME/.config/zsh/init/mise.zsh" ]; then
  source "$HOME/.config/zsh/init/mise.zsh"
fi

# alias
(( $+commands[bat] )) && alias cat="bat"
# eza prints nothing for a bare listing when stdout is not a terminal, so a
# piped `ls` (an agent shell, `ls | head`) would silently lose its output.
# Pass the current directory explicitly unless the caller already names a path.
if (( $+commands[eza] )); then
  ls() {
    local arg
    local -a args
    args=("$@")
    for arg in "${args[@]}"; do
      if [[ $arg != -* ]]; then
        eza --icons=auto "${args[@]}"
        return
      fi
    done
    eza --icons=auto "${args[@]}" .
  }
fi
(( $+commands[fd] )) && alias find="fd"
(( $+commands[zoxide] )) && alias cd="z"
(( $+commands[gomi] )) && alias rm="gomi"
(( $+commands[sd] )) && alias sd="sed"

for zshrc_file in ~/.config/zsh/rc.d/*.zsh(.N); do
  source "$zshrc_file"
done

(( $+commands[starship] )) && eval "$(starship init zsh)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[git-wt] )) && eval "$(git wt --init zsh)"

if (( $+commands[op] )); then
  zsh-defer -c 'eval "$(op completion zsh)"; compdef _op op'
fi
