# ~/.zshenv: minimal environment for all zsh shells.

typeset -U path PATH

if [ -d "$HOME/bin" ]; then
    case ":$PATH:" in
        *":$HOME/bin:"*) ;;
        *) PATH="$HOME/bin${PATH:+:$PATH}" ;;
    esac
fi

if [ -d "$HOME/.local/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
    esac
fi

if [ -d "/snap/bin" ]; then
    case ":$PATH:" in
        *":/snap/bin:"*) ;;
        *) PATH="${PATH:+$PATH:}/snap/bin" ;;
    esac
fi

# mise shims keep managed tools (pi, rtk, ...) available to non-interactive
# shells such as `ssh host '<command>'`, which never source .zprofile or
# .zshrc. Append after ~/.local/bin so the python wrappers there still win.
_mise_shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
if [ -d "$_mise_shims" ]; then
    case ":$PATH:" in
        *":$_mise_shims:"*) ;;
        *) PATH="${PATH:+$PATH:}$_mise_shims" ;;
    esac
fi
unset _mise_shims

export PATH

# Load the 1Password service account token from an unmanaged file when present,
# so headless shells (e.g. over SSH) can use the op CLI with no prompts.
# Keep the token file out of this repository and chmod 600 it.
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -s "$HOME/.config/op/service-account-token" ]; then
    export OP_SERVICE_ACCOUNT_TOKEN="$(<"$HOME/.config/op/service-account-token")"
fi
