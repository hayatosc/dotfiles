{{ if eq (index . "profile") "dot-cloud" -}}
{{- $stateDir := index . "dotCloudStateDir" -}}
{{- if not (kindIs "string" $stateDir) -}}
{{- fail "dot-cloud requires an absolute dotCloudStateDir in chezmoi data" -}}
{{- end -}}
{{- if not (hasPrefix "/" $stateDir) -}}
{{- fail "dot-cloud requires an absolute dotCloudStateDir in chezmoi data" -}}
{{- end -}}
# dot-cloud: explicit profile; keep system rm and Python behavior unchanged.
export DOT_CLOUD_STATE_DIR={{ $stateDir | shellQuote }}
export MISE_CONFIG_DIR="$HOME/.config/mise"
export MISE_GLOBAL_CONFIG_FILE="$MISE_CONFIG_DIR/config.toml"
export MISE_DATA_DIR="$HOME/.local/share/mise"
export MISE_CACHE_DIR="$DOT_CLOUD_STATE_DIR/cache/mise"
export MISE_STATE_DIR="$DOT_CLOUD_STATE_DIR/mise"
typeset -U path PATH
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
# Shims cover interactive and non-interactive shells, without executing hooks.
[[ -d "$HOME/.local/share/mise/shims" ]] && path=("$HOME/.local/share/mise/shims" $path)
export PATH
{{ else -}}
# ~/.zshenv: minimal environment for all zsh shells.

typeset -U path PATH

if [ -d "$HOME/bin" ]; then
    case ":$PATH:" in
        *":$HOME/bin:"*) ;;
        *) PATH="$HOME/bin${PATH:+:$PATH}" ;;
    esac
fi

if [ -d "$HOME/.local/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
    esac
fi

if [ -d "/snap/bin" ]; then
    case ":$PATH:" in
        *":/snap/bin:"*) ;;
        *) PATH="${PATH:+$PATH:}/snap/bin" ;;
    esac
fi

export PATH
{{ end -}}
