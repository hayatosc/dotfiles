#!/bin/bash
# wezterm.lua hash: {{ include "dot_wezterm.lua" | sha256sum }}

# WezTerm runs on the Windows side and reads %USERPROFILE%\.wezterm.lua,
# so mirror the applied config there. Nothing to do outside WSL.
if ! grep -qi microsoft /proc/version 2>/dev/null && [ -z "$WSL_DISTRO_NAME" ]; then
    exit 0
fi

WIN_USERPROFILE=""

if command -v wslvar >/dev/null 2>&1; then
    WIN_USERPROFILE=$(wslvar USERPROFILE 2>/dev/null)
elif command -v cmd.exe >/dev/null 2>&1; then
    WIN_USERPROFILE=$(cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')
fi

# Both resolvers report a Windows path (C:\Users\...); map it onto the WSL mount.
if [ -n "$WIN_USERPROFILE" ]; then
    WIN_USERPROFILE=$(wslpath -u "$WIN_USERPROFILE" 2>/dev/null)
fi

if [ -z "$WIN_USERPROFILE" ] || [ ! -d "$WIN_USERPROFILE" ]; then
    echo "[chezmoi] Failed to resolve Windows USERPROFILE; skipped .wezterm.lua sync" >&2
    exit 0
fi

cp -f "$HOME/.wezterm.lua" "$WIN_USERPROFILE/.wezterm.lua"
echo "[chezmoi] Synced .wezterm.lua to Windows USERPROFILE: $WIN_USERPROFILE/.wezterm.lua"
