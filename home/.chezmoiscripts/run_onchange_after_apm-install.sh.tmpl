#!/bin/bash
# Re-run when the manifest, lock, license, deployer, or any local skill changes.
# manifest: {{ output "sha256sum" (joinPath .chezmoi.sourceDir ".." "skills" "apm.yml") }}
# lock: {{ output "sha256sum" (joinPath .chezmoi.sourceDir ".." "skills" "apm.lock.yaml") }}
# license: {{ output "sha256sum" (joinPath .chezmoi.sourceDir ".." "skills" ".licenses" "yomiyasu.LICENSE") }}
# deployer: {{ output "sha256sum" (joinPath .chezmoi.sourceDir ".." "scripts" "agent_skills.py") }}
# local skills: {{ output "python3" "-c" "import hashlib, pathlib, sys; root=pathlib.Path(sys.argv[1]); files=sorted(p for d in root.iterdir() if d.is_dir() and (d/'SKILL.md').is_file() for p in d.rglob('*') if p.is_file()); print(hashlib.sha256(b''.join(str(p.relative_to(root)).encode()+p.read_bytes() for p in files)).hexdigest())" (joinPath .chezmoi.sourceDir ".." "skills") }}

set -euo pipefail

export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"
command -v apm >/dev/null || { echo "APM is missing; run mise install github:microsoft/apm first" >&2; exit 1; }
command -v uv >/dev/null || { echo "uv is missing; run mise install uv first" >&2; exit 1; }
repo={{ joinPath .chezmoi.sourceDir ".." | quote }}
uv run --frozen --project "$repo" python "$repo/scripts/agent_skills.py" --apm "$(command -v apm)"
