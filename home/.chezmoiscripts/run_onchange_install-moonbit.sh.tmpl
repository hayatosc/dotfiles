#!/bin/bash
# Install the MoonBit toolchain outside mise.
#
# mise used to install MoonBit through a self-hosted vfox plugin. That plugin has
# no registry entry, so "moonbit" cannot be resolved for the lockfile platforms
# and every "mise lock" run (which CI uses to refresh mise.lock) aborted. Keeping
# the toolchain out of mise keeps the lockfile clean; ~/.zshenv puts its bin on
# PATH. Bump the marker below to reinstall the latest toolchain.
set -uo pipefail

# moonbit-install: 2026-11-18
MOON_HOME="${MOON_HOME:-$HOME/.local/share/moonbit}"
export MOON_HOME

# The upstream installer appends a PATH line to the shell rc file it detects.
# Both .zshrc and .bashrc are managed by chezmoi, so point it at a shell it does
# not know to keep the installer from editing them.
export SHELL=/bin/false

if [ -x "$MOON_HOME/bin/moon" ]; then
    echo "MoonBit toolchain already installed at $MOON_HOME"
    exit 0
fi

echo "Installing the MoonBit toolchain to $MOON_HOME..."
if ! curl -fsSL https://cli.moonbitlang.com/install/unix.sh | bash; then
    echo "Warning: failed to install the MoonBit toolchain; run this script manually." >&2
    exit 0
fi
